# Do not commit a populated .env file.
SENTINEL_DATABASE_PATH=data/sentinel.db
# true: deterministic offline assessments labelled Demo; false: use OPENAI_API_KEY.
SENTINEL_DEMO_MODE=true
SENTINEL_OPENAI_MODEL=gpt-4.1-mini
# Explicit assessing-model version override (stored only when set; never invented).
# SENTINEL_OPENAI_MODEL_VERSION=
# Minimum matching reports before a model comparison reports sufficient data.
SENTINEL_MODEL_INTEL_MIN_SAMPLE=5
# true: block all writes (submissions, status/verification, notes, actions, triage, demo reset).
SENTINEL_READ_ONLY=false
# Lightweight in-memory submission throttle (resets on restart; not shared across workers).
SENTINEL_SUBMISSION_RATE_LIMIT=20
SENTINEL_SUBMISSION_RATE_WINDOW=3600
# OPENAI_API_KEY=
